# Copy to .env and uncomment to open tasker to another address as well as
# localhost, e.g. this machine's Tailscale address (`tailscale ip -4`).
# Anyone who can reach that address can read and change everything in tasker.
#TASKER_EXTRA_BIND_ADDRESS=100.64.0.1

# Push a notification to your phone when a plan waits for review or work waits
# to merge, through ntfy (https://ntfy.sh, or your own ntfy server). Pick a
# topic name nobody can guess: anyone who knows it can read the messages.
# Install the ntfy app and subscribe to the same topic.
#TASKER_NOTIFY_URL=https://ntfy.sh/tasker-change-this-to-something-random
# Access token, if your ntfy topic is protected.
#TASKER_NOTIFY_TOKEN=
# The address you open tasker at, so tapping a notification opens the page.
#TASKER_PUBLIC_URL=http://100.64.0.1:7777

# Serve tasker through a shared Traefik on this machine at a name of its own
# (see compose.edge-proxy.yaml). Both lines are needed.
#COMPOSE_FILE=docker-compose.yml:compose.edge-proxy.yaml
#TASKER_HOST=tasker.example.lan
